# Copy this file to .env and fill in real values. Never commit .env.

# Which provider to use: "gemini" (default, recommended) or "openrouter"
LLM_PROVIDER=gemini

# From aistudio.google.com/apikey (free tier, no credit card required)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxx

# Only needed if LLM_PROVIDER=openrouter. Get one at openrouter.ai/keys
OPENROUTER_API_KEY=
# Check openrouter.ai/models?max_price=0 for the current live free model IDs
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Local Postgres for development. On Zerops this is injected automatically
# as an env var from the connected Postgres service - see README.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/newnotes

PORT=3000

# Optional — enables the "Send reminder email now" button and the daily
# 8am digest. Get a free key at resend.com (no card, 3000 emails/mo free).
# On the free tier without a verified domain, you can only send TO the
# email address you signed up to Resend with.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
REMINDER_EMAIL=you@example.com
